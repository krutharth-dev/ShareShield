{
  "name": "shareshield-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "worker:check": "wrangler deploy --dry-run",
    "worker:v2:check": "wrangler deploy --config wrangler.v2.jsonc --dry-run",
    "worker:v2:deploy": "wrangler deploy --config wrangler.v2.jsonc",
    "extend:dev": "vite --config vite.extend.config.ts --host 127.0.0.1",
    "extend:build": "tsc -b && vite build --config vite.extend.config.ts"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-interaction-manager": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-rotate": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-search": "^2.15.1",
    "@embedpdf/plugin-selection": "^2.15.1",
    "@embedpdf/plugin-thumbnail": "^2.15.1",
    "@embedpdf/plugin-tiling": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/plugin-zoom": "^2.15.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/kan": "1.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "extend-ai": "2.5.0",
    "ibantools": "4.5.4",
    "libphonenumber-js": "1.12.33",
    "lucide-react": "^0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "wrangler": "^4.135.0"
  }
}
