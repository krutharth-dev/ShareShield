{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shareshield-mini",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "previews": {}
}

